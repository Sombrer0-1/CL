[Unit]
Description=Orion fullmem_v4 detached queue executor
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/zhuzetong/research/cl/Reproduce-Orion
ExecStart=/home/zhuzetong/miniconda3/envs/orion/bin/python -m orion_repro.stages.fullmem_v4 executor-run
Restart=on-failure
RestartSec=5
Environment=WANDB_MODE=disabled
Environment=WANDB_DISABLED=true
Environment=PYTHONUNBUFFERED=1
KillMode=mixed
OOMPolicy=continue
TimeoutStopSec=30

[Install]
WantedBy=default.target
